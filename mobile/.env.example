# ── Expo public env vars (EXPO_PUBLIC_ prefix is required) ──────────────────
# These are bundled into the app. Do NOT put secrets here.
# Copy this file to .env and fill in real values from your Supabase dashboard → Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Your deployed backend API base URL (no trailing slash)
EXPO_PUBLIC_API_URL=https://6-feet-above-more.vercel.app
