APP_URL="MY_APP_URL"

# ── Supabase (Backend — Node.js server only) ──────────────────
# Get these from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Direct PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"

# ── Supabase (Frontend — Vite VITE_ prefix required) ─────────
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ── EarnKaro API Key ─────────────────────────────────────────
EARNKARO_API_KEY="YOUR_EARNKARO_API_KEY"

# ── Gemini (product curation / discovery / retag) ─────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-lite-latest"
# Safety buffer under the free-tier ~1000 req/day cap
GEMINI_DAILY_LIMIT="900"

# ── AI Jobs scheduler (discovery/retag "tick" endpoint) ───────
# Shared secret the GitHub Actions workflow (.github/workflows/ai-jobs-tick.yml)
# sends as "Authorization: Bearer $CRON_SECRET" to POST /api/admin/ai-jobs/tick.
# Generate any long random string; set the same value here and as the
# CRON_SECRET GitHub Actions repo secret. Also set APP_URL as a repo secret
# (your deployed site's base URL) — that one isn't read from this file.
CRON_SECRET="YOUR_RANDOM_CRON_SECRET"

