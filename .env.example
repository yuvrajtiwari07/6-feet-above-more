APP_URL="MY_APP_URL"

# ── Supabase (Backend — Node.js server only) ──────────────────
# Get these from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Direct PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"

# ── Supabase (Frontend — Vite VITE_ prefix required) ─────────
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ── EarnKaro API Key ─────────────────────────────────────────
EARNKARO_API_KEY="YOUR_EARNKARO_API_KEY"

# ── Gemini (product curation / discovery / retag) ─────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-lite-latest"
# Safety buffer under the free-tier ~1000 req/day cap
GEMINI_DAILY_LIMIT="900"

# ── AI Jobs "tick" endpoint (discovery/retag worker) ──────────
# POST /api/admin/ai-jobs/tick advances one AI discovery/retag job.
# Normally you don't need this: the web admin panel and mobile admin app
# both have an "AI Jobs Auto-Run" toggle that pings this endpoint on an
# interval using the logged-in admin's own session — no separate secret
# needed for that path. CRON_SECRET is only for triggering it yourself
# from outside the app (a personal script, a cron job on your own machine,
# etc.) without logging in — optional, only set it if you want that.
CRON_SECRET="YOUR_RANDOM_CRON_SECRET"

